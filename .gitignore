# ==============================================================================
# SAMBARN MICRO FINANCE PVT. LTD. — OFFICIAL .gitignore
# Prevents accidental commitment of private data, unconsented photos, and secrets
# ==============================================================================

# 1. Customer Activity Photographs (Pending Written Consent under DPDP Act 2023)
assets/images/client/company-activities-*.webp

# 2. Private Data, Credentials, Tokens & Inquiry Logs
private/setup-token.txt
private/config.php
private/data/*.jsonl
private/data/*.json
private/backend_test_results.json

# 3. Build & Release Staging Artifacts
dist_public_release/
audit_screenshots/
*.log

# 4. Internal Audit & Compliance Reports
SMF_FINAL_RELEASE_AUDIT.md
SMF_FINAL_UPDATE_REPORT.md

# 5. Backup Archives & Temporary Files
*_backup_*
*.bak
*.tmp
*.swp
*~

# 6. Unapproved Document Annexures (Personal Director Photos & Internal Filing Details)
assets/images/documents/doc-gst-page-2.webp
assets/images/documents/doc-gst-page-3.webp

# 7. Operating System & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
